# SDD-Infra Environment Configuration

# OpenRouter API Key (Optional: Required only for live LLM translation; leave empty for ₹0 offline mock mode)
OPENROUTER_API_KEY=

# Primary Model Selection
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Fallback Model Selection
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-exp:free

# Optional: Path to terraform or opa binaries if not on PATH
# TERRAFORM_BINARY=C:\Users\dwive\bin\terraform.exe
# OPA_BINARY=C:\Users\dwive\bin\opa.exe
