{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InfrastructureSpecification",
  "type": "object",
  "required": [
    "spec_version",
    "application",
    "environment",
    "services",
    "security",
    "metadata"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "1.0"
    },
    "application": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["replicas", "image"],
        "properties": {
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9/_.-]+:[a-z0-9._-]+$"
          },
          "resources": {
            "type": "object",
            "properties": {
              "cpu": { "type": "string" },
              "memory": { "type": "string" }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "required": ["public_access", "ssh"],
      "properties": {
        "public_access": { "type": "boolean" },
        "ssh": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["owner", "created_at"],
      "properties": {
        "owner": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
