{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourcePlanSchema",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "name", "replicas", "image", "tags"],
        "properties": {
          "type": { "const": "docker_container" },
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "replicas": { "type": "integer", "minimum": 1, "maximum": 10 },
          "image": { "type": "string" },
          "public_access": { "type": "boolean" },
          "ssh_enabled": { "type": "boolean" },
          "tags": {
            "type": "object",
            "required": ["owner"],
            "properties": {
              "owner": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
